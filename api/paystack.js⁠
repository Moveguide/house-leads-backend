const PAYSTACK_SECRET = process.env.PAYSTACK_SECRET_KEY;

/**
 * Fetch all active Nigerian banks from Paystack
 */
export async function fetchNigerianBanks() {
  try {
    const res = await fetch('https://api.paystack.co/bank?country=nigeria', {
      headers: {
        Authorization: `Bearer ${PAYSTACK_SECRET}`,
      },
    });
    const data = await res.json();
    if (data.status && Array.isArray(data.data)) {
      return data.data; // Returns array of { name, code, active, ... }
    }
    throw new Error(data.message || 'Failed to fetch bank list');
  } catch (err) {
    console.error('Paystack Fetch Banks Error:', err.message);
    return [];
  }
}

/**
 * Resolve NUBAN account number against a specific bank code
 * @param {string} accountNumber - 10-digit NUBAN
 * @param {string} bankCode - Paystack bank code
 */
export async function resolveBankAccount(accountNumber, bankCode) {
  if (!accountNumber || accountNumber.length !== 10 || !bankCode) {
    return { success: false, message: 'Invalid account number or bank code' };
  }

  try {
    const res = await fetch(
      `https://api.paystack.co/bank/resolve?account_number=${accountNumber}&bank_code=${bankCode}`,
      {
        method: 'GET',
        headers: {
          Authorization: `Bearer ${PAYSTACK_SECRET}`,
          'Content-Type': 'application/json',
        },
      }
    );

    const data = await res.json();

    if (data.status && data.data) {
      return {
        success: true,
        accountName: data.data.account_name,
        accountNumber: data.data.account_number,
        bankId: data.data.bank_id,
      };
    }

    return {
      success: false,
      message: data.message || 'Account verification failed',
    };
  } catch (err) {
    console.error('Paystack Resolve Error:', err.message);
    return { success: false, message: err.message };
  }
}
